# Supabase Postgres
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@xxxxx.pooler.supabase.com:5432/postgres"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-key"

# Server-only Supabase key
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Session signing secret
AUTH_SECRET="generate-your-own-secret"

# Admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"